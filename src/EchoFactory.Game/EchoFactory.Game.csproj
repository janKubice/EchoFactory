<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- MonoGame.Framework.DesktopGL ships SDL natives per-RID; analyzers off as errors here. -->
    <!-- Drop branding/app.ico to brand the Windows executable icon, then rebuild. -->
    <ApplicationIcon Condition="Exists('..\..\branding\app.ico')">..\..\branding\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EchoFactory.Core\EchoFactory.Core.csproj" />
    <ProjectReference Include="..\EchoFactory.Content\EchoFactory.Content.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EchoFactory.Game.Tests" />
  </ItemGroup>

  <!-- Copy the JSON content next to the executable so the game finds it after publish too. -->
  <ItemGroup>
    <None Include="..\..\data\**\*.json" Link="data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copy user branding (logo image, icon, README) next to the executable so it loads at runtime. -->
  <ItemGroup>
    <None Include="..\..\branding\**\*.*" Link="branding\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
