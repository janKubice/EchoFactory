{
  "schema_version": 1,
  "id": "lvl_route_01",
  "name": "Two Ways",
  "order": 12,
  "campaign": "Logic",
  "description": "A router (tool 7) sends each value one way if it matches the condition, the other way if not. Send <3 right, >=3 down. It never destroys items.",
  "grid": { "width": 3, "height": 3 },
  "max_ticks": 12,
  "par": { "ticks": 6, "footprint": 1 },
  "inventory": {
    "mode": "whitelist",
    "allowed": ["node_router"],
    "limits": { "node_router": 1 }
  },
  "fixed_nodes": [
    {
      "id": "gen",
      "type": "generator",
      "position": { "x": 0, "y": 1 },
      "direction": "right",
      "schedule": [
        { "tick": 0, "value": 1 },
        { "tick": 1, "value": 2 },
        { "tick": 2, "value": 3 },
        { "tick": 3, "value": 4 },
        { "tick": 4, "value": 5 }
      ]
    },
    {
      "id": "sink_lo",
      "type": "sink",
      "position": { "x": 2, "y": 1 },
      "expected": [1, 2]
    },
    {
      "id": "sink_hi",
      "type": "sink",
      "position": { "x": 1, "y": 2 },
      "expected": [3, 4, 5]
    }
  ]
}
